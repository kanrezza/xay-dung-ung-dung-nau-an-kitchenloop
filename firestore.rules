rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // Quản trị viên: CHỈ dựa vào custom claim của Firebase Auth (đặt bằng script với khoá
    // quản trị, xem tool/admin_tool). Không dùng users.role vì client ghi được (spec 002).
    function isAdmin() {
      return signedIn() && request.auth.token.get('admin', false) == true;
    }

    // Tài khoản đang đăng nhập không bị khoá (users/{uid}.isLocked != true).
    function notLocked() {
      let path = /databases/$(database)/documents/users/$(request.auth.uid);
      return !exists(path) || get(path).data.get('isLocked', false) != true;
    }

    // Các trường bị thay đổi trong lần update này
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // Không bao giờ được lưu mật khẩu trong Firestore.
    function noPassword() {
      return !request.resource.data.keys().hasAny(['password']);
    }

    // ===================== USERS =====================
    // Hồ sơ chỉ chủ tài khoản và quản trị viên đọc được; chỉ quản trị viên liệt kê được
    // (màn hình quản trị). Người thường không xem được email của nhau.
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();

      // Tự đăng ký: không tự gán quyền admin, không tự mở khoá, không lưu mật khẩu.
      allow create: if isOwner(userId)
        && request.resource.data.get('role', 'blogger') == 'blogger'
        && request.resource.data.get('isLocked', false) == false
        && noPassword()
        && request.resource.data.get('lastPostAt', request.time) == request.time;

      // Chủ tài khoản: role, isLocked chỉ quản trị viên đặt.
      // Quản trị viên: chỉ khoá/mở khoá người KHÁC, không sửa trường nào khác.
      allow update: if (isOwner(userId)
          && !changedKeys().hasAny(['role', 'isLocked', 'lockedAt'])
          && noPassword()
          // lastPostAt (chống spam bài cộng đồng) chỉ đặt được bằng thời gian máy chủ.
          && (!changedKeys().hasAny(['lastPostAt']) || request.resource.data.lastPostAt == request.time)
          // Tên hiển thị (hiện trên bài cộng đồng): 1–40 ký tự, không link/từ cấm (spec 005).
          && (!changedKeys().hasAny(['name'])
            || (request.resource.data.name is string
              && request.resource.data.name.trim().size() >= 1 && request.resource.data.name.size() <= 40
              && cleanText(request.resource.data.name)))
          // Ảnh đại diện dạng link: chỉ link Firebase Storage hoặc rỗng, không nhận link tuỳ ý.
          && (!changedKeys().hasAny(['avatarUrl'])
            || request.resource.data.avatarUrl == null
            || (request.resource.data.avatarUrl is string
              && request.resource.data.avatarUrl.matches('https://firebasestorage[.]googleapis[.]com/.*')))
          // Ảnh đại diện lưu thẳng trong hồ sơ (ảnh đã thu nhỏ 256 px, dạng data URI base64):
          // chỉ nhận ảnh, tối đa 150 000 ký tự (~110 KB) để hồ sơ luôn nhỏ.
          && (!changedKeys().hasAny(['avatarData'])
            || request.resource.data.avatarData == null
            || (request.resource.data.avatarData is string
              && request.resource.data.avatarData.size() <= 150000
              && request.resource.data.avatarData.matches('data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+'))))
        || (isAdmin()
          && userId != request.auth.uid
          && changedKeys().hasOnly(['isLocked', 'lockedAt'])
          && request.resource.data.isLocked is bool);

      allow delete: if isOwner(userId);
    }

    // ===================== FOODS (dữ liệu của bản cũ, CHỈ ĐỌC) =====================
    // KitchenLoop chỉ đọc món của chính mình để chuyển sang `recipes`
    // (LegacyMigrationService). Không ai được ghi: dữ liệu cũ không bị sửa hay xoá
    // từ ứng dụng (Constitution, mục Ràng buộc bổ sung).
    match /foods/{foodId} {
      allow read: if signedIn() && resource.data.authorId == request.auth.uid;
      allow write: if false;

      match /{sub=**} {
        allow read, write: if false;
      }
    }

    // ===================== RECIPES (KitchenLoop GĐ1) =====================
    // Công thức riêng tư theo từng người dùng. Admin KHÔNG có đặc quyền đọc.
    // Tài khoản bị khoá không đọc/ghi được (spec 002, FR-004).

    // Ràng buộc kích thước/kiểu của một công thức (xem specs/001-.../data-model.md).
    function validRecipe(d) {
      return d.title is string
        && d.title.size() > 0 && d.title.size() <= 120
        && d.baseServings is int
        && d.baseServings >= 1 && d.baseServings <= 100
        && d.ingredients is list
        && d.ingredients.size() >= 1 && d.ingredients.size() <= 100
        && d.steps is list
        && d.steps.size() >= 1 && d.steps.size() <= 100
        && d.get('tags', []).size() <= 20
        && d.get('note', '').size() <= 2000;
    }

    // Thông tin video hướng dẫn trên công thức (spec 006): null hoặc đúng dạng, tối đa 28 mẩu.
    function validVideo(v) {
      return v == null
        || (v is map
          && v.id is string && v.id.matches('[A-Za-z0-9]{6,40}')
          && v.chunkCount is int && v.chunkCount >= 1 && v.chunkCount <= 28
          && v.sizeBytes is int && v.sizeBytes >= 1 && v.sizeBytes <= 21000000);
    }

    match /recipes/{recipeId} {
      // resource == null: đọc document chưa tồn tại trả về "không tồn tại"
      // thay vì lỗi quyền.
      allow get: if signedIn() && notLocked()
        && (resource == null || resource.data.ownerId == request.auth.uid);

      // Truy vấn danh sách bắt buộc có where('ownerId', '==', uid).
      allow list: if signedIn() && notLocked()
        && resource.data.ownerId == request.auth.uid;

      allow create: if signedIn() && notLocked()
        && request.resource.data.ownerId == request.auth.uid
        && validRecipe(request.resource.data);

      // ownerId bất biến.
      allow update: if signedIn() && notLocked()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && validRecipe(request.resource.data)
        && validVideo(request.resource.data.get('video', null));

      allow delete: if signedIn() && notLocked()
        && resource.data.ownerId == request.auth.uid;

      // Mẩu video hướng dẫn (spec 006): Cloud Storage bị khoá nên video được cắt thành mẩu
      // ≤ 750 000 byte lưu ở đây. Chỉ chủ công thức đọc/ghi; mẩu mang ownerId để vẫn xoá được
      // khi công thức đã bị xoá.
      match /videoChunks/{chunkId} {
        allow get: if signedIn() && notLocked()
          && (resource == null || resource.data.ownerId == request.auth.uid);
        allow create, update: if signedIn() && notLocked()
          && get(/databases/$(database)/documents/recipes/$(recipeId)).data.ownerId == request.auth.uid
          && request.resource.data.keys().hasOnly(['ownerId', 'videoId', 'index', 'data'])
          && request.resource.data.ownerId == request.auth.uid
          && request.resource.data.data is bytes
          && request.resource.data.data.size() <= 750000
          && request.resource.data.index is int
          && request.resource.data.index >= 0 && request.resource.data.index < 28
          && chunkId.matches(request.resource.data.videoId + '_[0-9]{2}');
        allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
      }
    }

    // ===================== THỰC ĐƠN TUẦN, ĐI CHỢ (spec 003) =====================
    // Mỗi tuần một tài liệu, id = "{uid}_{yyyy-MM-dd}" (ngày thứ 2). Chỉ chủ sở hữu, không bị khoá.
    function ownWeekDoc(docId) {
      return signedIn() && notLocked()
        && docId.matches(request.auth.uid + '_[0-9]{4}-[0-9]{2}-[0-9]{2}');
    }

    function validWeekDoc(docId, d) {
      return d.ownerId == request.auth.uid
        && d.weekStart is string
        && docId == request.auth.uid + '_' + d.weekStart;
    }

    match /weekPlans/{planId} {
      allow get: if ownWeekDoc(planId)
        && (resource == null || resource.data.ownerId == request.auth.uid);
      allow create, update: if ownWeekDoc(planId)
        && validWeekDoc(planId, request.resource.data)
        && request.resource.data.entries is list
        && request.resource.data.entries.size() <= 63;
      allow delete: if ownWeekDoc(planId) && resource.data.ownerId == request.auth.uid;
    }

    match /shoppingLists/{listId} {
      allow get: if ownWeekDoc(listId)
        && (resource == null || resource.data.ownerId == request.auth.uid);
      allow create, update: if ownWeekDoc(listId)
        && validWeekDoc(listId, request.resource.data)
        && request.resource.data.checked is list
        && request.resource.data.checked.size() <= 500
        && request.resource.data.extras is list
        && request.resource.data.extras.size() <= 100;
      allow delete: if ownWeekDoc(listId) && resource.data.ownerId == request.auth.uid;
    }

    // ===================== CỘNG ĐỒNG (spec 004) =====================
    // Kiểm duyệt TỰ ĐỘNG ở đây (không chỉ ở ứng dụng). Các mẫu regex khớp với
    // lib/features/community/domain/moderation.dart (có test kiểm tra).
    function bannedRe() { return '(?s).*(địt|lồn([^g]|$)|cặc|buồi|đéo|vãi l|vcl|fuck|shit|bitch|porn|sex|xxx|18[+]|casino|cá độ|cá cược|lô đề|vay tiền|kiếm tiền online|bitcoin|zalo:|inbox).*'; }
    function linkRe() { return '(?s).*(https?://|www[.]|[.](com|net|org|vn|io|xyz|info|ly)([/ ]|$)).*'; }
    function repeatRe() { return '(?s).*(aaaaa|bbbbb|ccccc|ddddd|eeeee|fffff|ggggg|hhhhh|iiiii|jjjjj|kkkkk|lllll|mmmmm|nnnnn|ooooo|ppppp|qqqqq|rrrrr|sssss|ttttt|uuuuu|vvvvv|wwwww|xxxxx|yyyyy|zzzzz|00000|11111|22222|33333|44444|55555|66666|77777|88888|99999).*'; }
    function lettersRe() { return '(?s).*[a-zA-ZÀ-ỹ].*[a-zA-ZÀ-ỹ].*'; }

    // Một đoạn chữ "sạch": không link, không từ cấm, không ký tự lặp 5 lần.
    function cleanText(t) {
      return t is string
        && !t.lower().matches(linkRe())
        && !t.lower().matches(bannedRe())
        && !t.lower().matches(repeatRe());
    }

    function goodIngredient(i) {
      return i.name is string && i.name.trim().size() >= 2 && cleanText(i.name);
    }

    function goodStep(st) {
      return st.text is string && st.text.trim().size() >= 8 && cleanText(st.text);
    }

    // Nội dung bài hợp lệ. Rules không có vòng lặp: kiểm tra kỹ 2 nguyên liệu và 2 bước đầu,
    // phần còn lại do ứng dụng kiểm tra và cộng đồng báo cáo.
    function validPost(d) {
      return d.title is string
        && d.title.trim().size() >= 3 && d.title.size() <= 80
        && d.title.matches(lettersRe()) && cleanText(d.title)
        && d.note is string && d.note.size() <= 1000 && cleanText(d.note)
        && d.authorName is string && d.authorName.size() >= 1 && d.authorName.size() <= 60 && cleanText(d.authorName)
        && d.baseServings is int && d.baseServings >= 1 && d.baseServings <= 100
        && d.ingredients is list && d.ingredients.size() >= 2 && d.ingredients.size() <= 50
        && d.steps is list && d.steps.size() >= 2 && d.steps.size() <= 50
        && goodIngredient(d.ingredients[0]) && goodIngredient(d.ingredients[1])
        && goodStep(d.steps[0]) && goodStep(d.steps[1])
        && d.tags is list && d.tags.size() <= 10;
    }

    // Chống spam: tối đa 1 bài mới mỗi 2 phút. Lần ghi tạo bài phải đặt users/{uid}.lastPostAt
    // = request.time trong cùng batch, và lần đăng trước phải cách ít nhất 2 phút.
    function postRateOk() {
      let u = /databases/$(database)/documents/users/$(request.auth.uid);
      return getAfter(u).data.get('lastPostAt', null) == request.time
        && (!exists(u)
          || get(u).data.get('lastPostAt', null) == null
          || get(u).data.lastPostAt < request.time - duration.value(2, 'm'));
    }

    // Báo cáo: tăng reportCount đúng 1, kèm tạo reports/{uid} trong cùng batch; đủ 3 thì ẩn bài.
    function validReportBump(postId) {
      let r = /databases/$(database)/documents/communityPosts/$(postId)/reports/$(request.auth.uid);
      let n = request.resource.data.reportCount;
      return signedIn() && notLocked()
        && resource.data.authorId != request.auth.uid
        && resource.data.status == 'visible'
        && changedKeys().hasOnly(['reportCount', 'status'])
        && n == resource.data.reportCount + 1
        && !exists(r) && existsAfter(r)
        && ((n < 3 && request.resource.data.status == resource.data.status)
          || (n >= 3 && request.resource.data.status == 'hidden'));
    }

    // Lượt thích (spec 007): người khác thêm/bớt đúng uid của mình trong likedBy, không đụng trường khác.
    function validLikeChange() {
      let me = request.auth.uid;
      let before = resource.data.get('likedBy', []);
      let after = request.resource.data.likedBy;
      return signedIn() && notLocked()
        && resource.data.authorId != me
        && changedKeys().hasOnly(['likedBy'])
        && after is list && after.size() <= 5000
        && ((resource.data.status == 'visible' && !(me in before)
              && after.toSet() == before.toSet().union([me].toSet()) && after.size() == before.size() + 1)
          || (me in before
              && after.toSet() == before.toSet().difference([me].toSet()) && after.size() == before.size() - 1));
    }

    // Cờ do hệ thống quản lý: bài mới chưa nổi bật, chưa có lượt thích; byAdmin phải đúng quyền thật.
    function freshPostFlags(d) {
      return d.get('featured', false) == false
        && d.get('likedBy', []).size() == 0
        && d.get('byAdmin', false) == isAdmin();
    }

    match /communityPosts/{postId} {
      // Bài đang hiện: ai đăng nhập (không bị khoá) cũng xem được. Bài ẩn/gỡ: chỉ tác giả và admin.
      allow get: if signedIn() && notLocked()
        && (resource == null || resource.data.status == 'visible'
          || resource.data.authorId == request.auth.uid || isAdmin());
      allow list: if signedIn() && notLocked()
        && (resource.data.status == 'visible' || resource.data.authorId == request.auth.uid || isAdmin());

      allow create: if signedIn() && notLocked()
        && postId == request.auth.uid + '_' + request.resource.data.sourceRecipeId
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.status == 'visible'
        && request.resource.data.reportCount == 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && validPost(request.resource.data)
        && freshPostFlags(request.resource.data)
        && postRateOk();

      allow update: if
        // Tác giả chia sẻ lại (sửa nội dung): không đổi được trạng thái, số báo cáo, chủ bài.
        (signedIn() && notLocked()
          && resource.data.authorId == request.auth.uid
          && !changedKeys().hasAny(['authorId', 'sourceRecipeId', 'status', 'reportCount', 'createdAt', 'likedBy', 'featured'])
          && request.resource.data.get('byAdmin', false) == isAdmin()
          && request.resource.data.updatedAt == request.time
          && validPost(request.resource.data))
        // Quản trị viên duyệt bài: đổi trạng thái, đặt lại số báo cáo, ghim/bỏ ghim nổi bật (spec 007).
        || (isAdmin()
          && changedKeys().hasOnly(['status', 'reportCount', 'updatedAt', 'featured'])
          && request.resource.data.status in ['visible', 'hidden', 'removed']
          && request.resource.data.reportCount is int && request.resource.data.reportCount >= 0
          && request.resource.data.get('featured', false) is bool)
        // Người khác báo cáo.
        || validReportBump(postId)
        // Người khác thích / bỏ thích.
        || validLikeChange();

      allow delete: if signedIn() && (resource.data.authorId == request.auth.uid || isAdmin());

      match /reports/{reporterId} {
        allow create: if signedIn() && notLocked()
          && reporterId == request.auth.uid
          && get(/databases/$(database)/documents/communityPosts/$(postId)).data.authorId != request.auth.uid
          && request.resource.data.keys().hasOnly(['reason', 'createdAt'])
          && request.resource.data.reason in ['spam', 'offensive', 'not_recipe', 'other']
          && request.resource.data.createdAt == request.time
          && getAfter(/databases/$(database)/documents/communityPosts/$(postId)).data.reportCount
            == get(/databases/$(database)/documents/communityPosts/$(postId)).data.reportCount + 1;
        allow read: if isAdmin();
        allow update, delete: if false;
      }
    }

    // ===================== THÔNG BÁO CHUNG (spec 007) =====================
    // Mọi người (không bị khoá) đọc; chỉ quản trị viên viết. Chữ rỗng = không có thông báo.
    match /appConfig/announcement {
      allow get: if signedIn() && notLocked();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['text', 'updatedAt'])
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 200
        && cleanText(request.resource.data.text)
        && request.resource.data.updatedAt == request.time;
      allow list, delete: if false;
    }

    // ===================== COLLECTION CŨ KHÁC =====================
    // meal_plans, followers, ... của bản cũ: KitchenLoop không dùng, khoá hoàn toàn.
    // Mọi collection không được khai báo ở trên cũng bị từ chối mặc định.
  }
}
